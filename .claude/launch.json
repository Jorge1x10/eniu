{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "eniu-mobile-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "mobile/eniu-mobile",
        "run",
        "web"
      ],
      "port": 8081
    },
    {
      "name": "eniu-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "client/eniu",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "eniu-landing",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "landing/eniuLanding",
        "run",
        "dev",
        "--",
        "--port",
        "5179"
      ],
      "port": 5179
    }
  ]
}
