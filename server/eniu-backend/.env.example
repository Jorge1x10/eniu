# Copia este archivo a `.env` para desarrollar. Las pruebas no lo necesitan:
# cada una define su propia configuración.
#
# Los valores de abajo son de ejemplo. En producción viven en el panel de
# Render, nunca en el repositorio.

# --- Imprescindibles -------------------------------------------------------
DATABASE_URL=postgresql://eniu:eniu@localhost:5432/eniu
SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_SECRET_KEY=cambia-esto-por-otra-cadena-larga-y-aleatoria
PASSWORD_RESET_SECRET_KEY=y-otra-mas-para-los-enlaces-de-recuperacion
# No cambiarla una vez en producción: invalida las claves de analíticas.
ANALYTICS_TOKEN_SECRET=una-cadena-larga-y-aleatoria-distinta

# --- Sesiones ----------------------------------------------------------------
# Iguales para correo, Google, Apple y registro.
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=30

# --- Red ---------------------------------------------------------------------
# Proxies entre el cliente y gunicorn: 1 en Render, 2 si hay un CDN delante,
# 0 en local sin proxy (si no, cualquiera podría falsear su IP).
TRUSTED_PROXY_COUNT=0
FRONTEND_URL=http://localhost:5173
# Origen de los menús públicos (`/m/<slug>`). Va dentro de los QR impresos.
PUBLIC_WEB_BASE_URL=http://localhost:5173
# Separados por comas. Debe incluir PUBLIC_WEB_BASE_URL.
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
FLASK_DEBUG=true
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5000

# --- Pedidos desde la mesa (docs/ORDERING.md) ---------------------------------
# Son de pago. Con una fecha, el plan gratuito también los tiene hasta ese día
# incluido (prueba). Vacía: sólo planes de pago.
ORDERS_FREE_PLAN_UNTIL=

# --- Versiones de la app móvil (docs/API_VERSIONING.md) --------------------
# Vacías no bloquean ni sugieren nada. Subir la mínima de una plataforma sólo
# cuando la versión nueva ya esté aprobada en esa tienda.
MOBILE_MIN_VERSION=
MOBILE_MIN_VERSION_IOS=
MOBILE_MIN_VERSION_ANDROID=
MOBILE_LATEST_VERSION=
MOBILE_LATEST_VERSION_IOS=
MOBILE_LATEST_VERSION_ANDROID=
MOBILE_STORE_URL_IOS=https://apps.apple.com/app/id6806468732
MOBILE_STORE_URL_ANDROID=https://play.google.com/store/apps/details?id=com.eniu.app

# --- Inicio de sesión con terceros ------------------------------------------
GOOGLE_CLIENT_ID=
APPLE_CLIENT_IDS=com.eniu.app
# Para revocar la sesión de Apple al borrar una cuenta (APPLE_CONFIGURATION.md).
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- Correo (recuperación de contraseña) -------------------------------------
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@eniu.app
MAIL_USE_TLS=true
PASSWORD_RESET_TOKEN_MINUTES=15

# --- Cobros -------------------------------------------------------------------
# Ver STRIPE_CONFIGURATION.md y REVENUECAT_CONFIGURATION.md.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ESSENTIAL_LOOKUP_KEY=eniu_essential_monthly
STRIPE_AUTOMATIC_TAX=false
STRIPE_TERMS_CONSENT=false
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_ALLOW_SANDBOX=false

# --- Escalado (opcional, ver COST_AND_SCALING.md) ----------------------------
REDIS_URL=
PUBLIC_MENU_CACHE_SECONDS=20
STORAGE_BACKEND=local
S3_BUCKET=
S3_PREFIX=
S3_REGION=auto
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
MAX_UPLOAD_MB=26

# --- gunicorn y base de datos (opcional) -------------------------------------
WEB_CONCURRENCY=2
WEB_THREADS=4
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=3
