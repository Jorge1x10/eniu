# Copia este archivo a `.env.local` para desarrollar. Producción usa
# `.env.production`, que sí está en el repositorio porque los dos valores son
# públicos: viajan dentro del bundle que descarga el navegador.

# API de Flask (server/eniu-backend), con el prefijo /api.
VITE_API_URL=http://localhost:5000/api

# Client ID web de Google OAuth (Google Cloud > Credentials).
VITE_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
